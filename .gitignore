# Dependencies
node_modules/

# Build output: electron-vite writes out/, electron-builder writes dist/
out/
dist/
resources/cli/
.wrangler/

# Playwright's traces, per-case artifacts and HTML report
test-results/
playwright-report/

# Pictures written by `npm run gallery` — evidence for a review, regenerated on demand, no image baseline
screenshots/

# Brand assets: deliberately not in the repo — the files stay local in brand/ (the logo's source of truth,
# variants and process archive); they just do not go into git yet
brand/

# Design drafts and implementation plans: the output of brainstorming / writing-plans, kept on this machine
# to go with the conversation, not committed
docs/superpowers/

# The visual companion's mockup screens (brainstorming), same reason
.superpowers/

# Python bytecode
__pycache__/

# A local shim: absolute paths and PATH baked in, not part of the build
npm.ps1

# ZCode's file-search ignore rules: written by the editor for this machine (and
# rewritten by its own sync), so they are configuration, not code
.zcodeignore
.zcode/

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
