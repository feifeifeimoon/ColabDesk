# Dependencies
node_modules/

# Build output: electron-vite writes out/, electron-builder writes dist/
out/
dist/
resources/cli/

# Playwright's traces, per-case artifacts and HTML report
test-results/
playwright-report/

# Pictures written by `npm run gallery` — tracked images for README
screenshots/*
!screenshots/00-start-page-light.png
!screenshots/00-start-page-dark.png
!screenshots/01-workbench-light.png
!screenshots/01-workbench-dark.png
!screenshots/02-focus-dark.png
!screenshots/04-new-session-light.png
!screenshots/05-terminal-tokyo-night-light.png
!screenshots/05-terminal-catppuccin-mocha-light.png
!screenshots/06-settings-usage-light.png
!screenshots/06-settings-external-light.png
!screenshots/08-file-tab-light.png

# Brand assets: final lockups tracked for README and website
brand/*
!brand/final/


# Design drafts and implementation plans: the output of brainstorming / writing-plans, kept on this machine
# to go with the conversation, not committed
docs/superpowers/

# Python bytecode
__pycache__/

# A local shim: absolute paths and PATH baked in, not part of the build
npm.ps1

# ZCode's file-search ignore rules: written by the editor for this machine (and
# rewritten by its own sync), so they are configuration, not code
.zcodeignore

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
