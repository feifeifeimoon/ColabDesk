# Cloudflare Pages reads this file; it is not served.
#
# Nothing here is fingerprinted (the page has no build step), so documents,
# scripts and styles revalidate on every visit; only the heavy binaries are
# cached. A day for images and fonts is short enough that a replaced screenshot
# does not linger, and long enough that a repeat visit costs almost nothing.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400
